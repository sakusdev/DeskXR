{
  "jsonid": "input_profile",
  "controller_type": "oculus_touch",
  "input_bindingui_mode": "controller_handed",
  "input_source": {
    "/input/trigger": { "type": "trigger", "order": 1 },
    "/input/grip": { "type": "trigger", "order": 2 },
    "/input/joystick": { "type": "joystick", "order": 3 },
    "/input/a": { "type": "button", "touch": true, "order": 4 },
    "/input/b": { "type": "button", "touch": true, "order": 5 },
    "/input/x": { "type": "button", "touch": true, "order": 6 },
    "/input/y": { "type": "button", "touch": true, "order": 7 },
    "/input/menu": { "type": "button", "order": 8 },
    "/output/haptic": { "type": "vibration", "order": 9 }
  },
  "default_bindings": []
}
